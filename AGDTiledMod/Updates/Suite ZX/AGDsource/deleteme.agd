		;ELSE
		;	LET DIRECTION = LEFT
		;ENDIF
		;LET SETTINGA = 0
	;ENDIF
ELSE
	;LET SETTINGA = 255
ENDIF

 
EVENT SPRITETYPE3

;		USER 14
;		AT Z 0 DISPLAY Z
;		AT Z 2 PRINT "CAJA       "
;		IF N = 3 PRINT "       " ENDIF
;		IF N = 4 PRINT "DETRAS " ENDIF
;		IF N = 5 PRINT "DELANTE" ENDIF
; 
;
; SETTINGA = DOWN		; DOWN = MODO CAJA, UP = RUEDA
; SETTINGB  DEFINE PELOTA, REBOTE VERTICAL
;
;	CAJA
;
;


; CHECK COLLISIONES
	LET A = 1
	IF COLLISION 2		; PRIORIDAD 1
		LET A = 0
	ELSE
		IF COLLISION 4		; PRIORIDAD 2
			LET A = 0
		ELSE
			IF COLLISION 0		; PRIORIDAD 3
				; fisica
				LET A = 0
			ELSE
				IF COLLISION 3		; PRIORIDAD 4
					LET A = 0
				ENDIF
			ENDIF
		ENDIF		
	ENDIF

	IF A = 0
		; COLISIONAN
			; LOCALIZA PERSONAJE
				OTHER
					LET COLUMN = X
					LET LINE = Y
					LET OPT = TYPE
				ENDSPRITE

				IF Y > LINE					; CAJA DEBAJO
					LET A = Y
					SUBTRACT LINE FROM A				; DIFERENCIA DE ALTURAS
					; PERSONAJE (PLAYER LINE) ARRIBA
						IF A >= 8
							; SUFICIENTE PARA MONTAR
								LET A = Y
								LET B = DIRECTION
								LET C = X
								OTHER
									LET Y = A
									SUBTRACT 12 FROM Y
									IF B = RIGHT
										IF CANGORIGHT
											SPRITERIGHT
										ENDIF
									ELSE
										IF B = LEFT
											IF CANGOLEFT
												SPRITELEFT
											ENDIF
										ENDIF
									ENDIF
									STOPFALL
									IF OPT = 0
										IF KEY DOWN
											IF DIRECTION LEFT
												LET SETTINGB = 0
												LET IMAGE = 4
												LET FRAME = 1
											ELSE
												IF DIRECTION RIGHT    ; Agacharse en otra postura
													LET SETTINGB = 0
													LET IMAGE = 5
													LET FRAME = 0		
												ENDIF
											ENDIF
										ENDIF
										IF KEY FIRE
											IF IMAGE < 2
												SUBTRACT 2 FROM Y
												JUMP K			; VARIABLE
											ENDIF
										ENDIF
										LET SETTINGA = 255
									ENDIF
								ENDSPRITE
								LET DIRECTION = DOWN		; PORTANDO PERSONAJE
						ENDIF
				ELSE
					; CAJA IGUAL O ARRIBA		
					; MUEVE CAJA IZQUIERDA O DERECHA
					LET A = LINE
					SUBTRACT Y FROM A				; DIFERENCIA DE ALTURAS	
					IF A < 8			; MISMA ALTURA O SUFICIENTE PARA EMPUJAR
						IF X > COLUMN
							; CAJA A LA DERECHA
								IF OPT = 2
									OTHER
										LET DIRECTION = LEFT
									ENDSPRITE										
								ENDIF
								IF OPT = 4
									OTHER
										LET DIRECTION = LEFT
									ENDSPRITE										
								ENDIF
								IF CANGORIGHT
									ADD 2 TO X
									IF CUSTOM
										OTHER
											SPRITELEFT
										ENDSPRITE
									ELSE
										SPRITERIGHT				; MUEVE
										LET DIRECTION = RIGHT
									ENDIF
									SUBTRACT 2 FROM X
								ELSE
									OTHER
										SPRITELEFT
									ENDSPRITE								
								ENDIF
						ELSE
							IF X < COLUMN
								; CAJA A LA IZQUIERDA
									IF OPT = 2
										OTHER
											LET DIRECTION = RIGHT
										ENDSPRITE
									ENDIF
									IF OPT = 4
										OTHER
											LET DIRECTION = RIGHT
										ENDSPRITE
									ENDIF
									IF CANGOLEFT
										SUBTRACT 2 FROM X
										IF CUSTOM
											OTHER
												SPRITERIGHT
											ENDSPRITE
										ELSE
											SPRITELEFT				; MUEVE
											LET DIRECTION = LEFT
										ENDIF
										ADD 2 TO X
									ELSE
										OTHER
											SPRITERIGHT
										ENDSPRITE
									ENDIF
							ELSE
								; SEPARAME
									SPRITERIGHT
							ENDIF
						ENDIF
					ENDIF
				ENDIF			
	ENDIF

; CHEQUEA MODO
	IF DIRECTION = DOWN			; SOPORTANDO PERSONAJE EN PLATABORMA
		IF SETTINGA = UP		; MODO PLATFORM
			LET DIRECTION = B
		ENDIF
	ENDIF
	
; CHEQUEA LIMITE PLATAFORMA
	SUBTRACT 10 FROM X
	IF CANGODOWN
		IF AIRBORNE = 0
			IF CANGOLEFT
				SPRITELEFT
				LET DIRECTION = LEFT
			ELSE					
				LET DIRECTION = RIGHT
			ENDIF
		ENDIF
	ENDIF
	ADD 10 TO X

	ADD 10 TO X
	IF CANGODOWN
		IF AIRBORNE = 0
			IF CANGORIGHT
				SPRITERIGHT
				LET DIRECTION = RIGHT
			ELSE
				LET DIRECTION = LEFT
			ENDIF
		ENDIF		
	ENDIF		
	SUBTRACT 10 FROM X


; CONTINUA EL MOVIMIENTO
	IF SETTINGA = UP
		IF DIRECTION = RIGHT
				IF CANGORIGHT
					SPRITERIGHT
				ELSE
					LET DIRECTION = LEFT
				ENDIF
		ELSE
			IF DIRECTION = LEFT
				IF CANGOLEFT
					SPRITELEFT
				ELSE					
					LET DIRECTION = RIGHT
				ENDIF
			ENDIF
		ENDIF		
	ENDIF
	
; CAE
	FALL			 
EVENT SPRITETYPE4


; SOLDADO


SPRITEINK 7			; Soldado
IF DIRECTION = LEFT
	LET IMAGE = 15
	LET FRAME = 0
    IF CANGOLEFT
        SPRITELEFT
        SUBTRACT 16 FROM X
        IF CANGODOWN
            LET DIRECTION = RIGHT
        ENDIF
        ADD 16 TO X
    ELSE
        LET DIRECTION = RIGHT
    ENDIF
ELSE
	LET IMAGE = 16
	LET FRAME = 0
    IF CANGORIGHT
        SPRITERIGHT
        ADD 16 TO X
        IF CANGODOWN
            LET DIRECTION = LEFT
        ENDIF
        SUBTRACT 16 FROM X
    ELSE
        LET DIRECTION = LEFT
    ENDIF
ENDIF

