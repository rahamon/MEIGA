				LET SETTINGB = 0
				LET IMAGE = 5
				LET FRAME = 1
				;ANIMATE VERYSLOW		;TIENE QUE PODERSE PARAR CUANDO SOLO DAMOS DOWN
			ENDIF
		ENDIF
	ENDIF
ENDIF
				
