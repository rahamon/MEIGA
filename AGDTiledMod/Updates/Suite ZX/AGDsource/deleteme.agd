	;	LET FRAME 0
	;	ANIMATE SLOW
ENDIF
	
	SPRITEINK 2
	 

EVENT SPRITETYPE5

; PELUSA
; 0 -- 1 -- 2 -- X

IF SETTINGB = 255
	GETRANDOM 3
	LET FRAME = RND
	LET SETTINGB = RND
	MULTIPLY SETTINGB BY 64
ENDIF

SUBTRACT 1 TO SETTINGB

IF SETTINGB = 0
	IF IMAGE = 17			; SI ES PELUSA
		LET IMAGE = 19
		LET FRAME = 2			; BORRALA
		GETRANDOM 128
		LET SETTINGB = RND		; GENERA RND
	ELSE					; SI ES BLANK
		LET IMAGE = 17			; SALE PELUSA
		LET FRAME = 0
	ENDIF
ENDIF

IF IMAGE = 17
	ANIMATE SLOW
ENDIF
 
EVENT SPRITETYPE6


; ARAÑA


SPRITEINK 7
IF SETTINGA 0				;Araña
	IF CANGOUP
		SPRITEUP
		LET IMAGE 18
		LET FRAME 1
	ELSE
		LET SETTINGA 1
	ENDIF
ELSE
	IF CANGODOWN
		SPRITEDOWN
		SPRITEDOWN
		LET IMAGE 18
		LET FRAME 0
	ELSE
		LET SETTINGA 0
	ENDIF
ENDIF

ANIMATE SLOW
IF COLLISION 0
	SUBTRACT 2 TO LIVES  
	BORDER 2
	BEEP 20 
ENDIF
SPRITEINK 2
 
EVENT SPRITETYPE7
			
; MAGNETO
		
; CHEQUEA IMAN PLAYER

	LET A = M
	ADD 16 TO A
	IF A > X			; SI PLAYER A MI DERECHA MAS 16
		SUBTRACT X FROM A		; DISTANCIA A COLUMNA MAGNETICA
		IF A < 32				; CAMPO SUFICIENTE
			IF SETTINGA = 255
				; DETERMINA K=(8+I*2)
					LET K = 8
					LET A = I
					MULTIPLY A BY 2
					ADD A TO K
					;MULTIPLY K BY 2		; GRAN SALTOx2
				LET SETTINGA = 0		; ESTADO SALTANDO
			ENDIF
		ELSE
			LET SETTINGA = 255
		ENDIF
	ELSE
		LET SETTINGA = 255
	ENDIF

; RESTAURA SALTO
	IF SETTINGA = 255
		; RESTAURA SALTO K=8-V
			LET K = 8
			SUBTRACT V FROM K
			; MODIFICA POR POCIMA DE SALTO
				IF GOT 2
					LET K = 8
				ENDIF
	ENDIF

; PLAY ANIMACION
	IF SETTINGA = 0
		ANIMATE FAST
	ELSE
		ANIMATE VERYSLOW
	ENDIF
	IF FRAME = 2
		LET FRAME = 0
	ENDIF
	 
EVENT SPRITETYPE8

; LOCALIZADOR PARA OBJETO-NPC = PERSONAJE NO JUGADOR
; APORTA LAS COORDENADAS Y LA SECREEN PARA LAS EFEMERIDES

; INSPECTOR
;
; SETTINGA:
; 0 vacio
; 1 explorado
; NN>16 efemerides (OBJs)
; 255 mision cumplida (REMOVE)
;
; SETTINGB = RELOJ: EFECTO REFLEJO, DESBLOQUEO INSPECCION
; E = AVANZA HISTORIA FLAG
; H = AVANZA HISTORIA
; GOT OBJ = ESCALETA

; INSPECCION en efemerides
	; SETPTR captura punteros de DATA EFEMERIDES
		; Esta hecho en EVENTGAMEINIT
	; READ SETTINGA lee efemeride para esta screen
		LET A = SCREEN
		USER 27			; SET INDEX = SCREEN
		LET OPT = 2		; modo READ A
		USER 17			; CALL EFFEMERIDES en EVENTNEWHIGHSCORE
		LET SETTINGA = A
	
; CHEQUEA MISION
	IF SETTINGA > 1		; CONTROL de efemerides
		IF SETTINGA <> 255
			; SETTINGA = OBJETOS DIRECTAMENTE equivalen al estado de mision
				; BOTELLAS
				; PARTES DEL RELOJ
				; EN LA SALA DEL BEBE
				; EN EL ARBOL
				; EN ALGUN PUNTO
				; EN SALA DE MUERTO
				; EN SALA DE DRAGON
					PUT X Y SETTINGA
					REMOVE
					EXIT
		ELSE
			;IF SCREEN = 1	; EN ESCENARIO DEL BEBE
			;	GET 33			; BORRAR BEBE
				; COLOCAR OBJETO OBTENIDO EN HISTORIAL OBJETOS IDEA***
			;ENDIF
		ENDIF
	ENDIF
	
		; NADA QUE HACER
			REMOVE
			EXIT

 
