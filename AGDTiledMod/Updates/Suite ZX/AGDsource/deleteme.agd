EVENT MAINLOOP1

; TEST MASK
	AT 0 15
	IF U = 0 PRINT "XOR " ENDIF
	IF U = 1 PRINT "MASK" ENDIF
	AT 1 15 DISPLAY tripledigits Z
				
IF LIVES > 99
	INK 4
	AT 23 2
	DISPLAY LIVES
ELSE
	IF LIVES < 100
		IF LIVES > 9
			INK 4
			AT 23 2
			PRINT " "
			DISPLAY LIVES
		ELSE
			IF LIVES < 10
				INK 2
				AT 23 2
				PRINT "  "
				DISPLAY LIVES
			ENDIF
		ENDIF
	ENDIF
ENDIF

IF LIVES < 1
	ENDGAME
ENDIF

	
; GAME PANELS
	IF P = 0
		; HUB
			;LET A = 2 CALL 24835      ; Selecciona Stage Hubo
			;LET C = 21
			;USER 11
			;WAITKEY
			
		; Inicia Ticker
			INK 2
			AT 22 3		
			TICKER 3 46
		
		; Revisar
		
		; LOAD OBJETOS
			LET A = 6 CALL 24835
		
		; WINDOW
			IF SCREEN > 38
				AT 0 15 PRINT "Zona C"
				LET B = 39      ; Desplazamiento en WorldMap
				LET U = 5
				LET A = 3 CALL 24835      ; Selecciona Banco Zona C
			ELSE
				IF SCREEN > 20
					AT 0 15 PRINT "Zona B"
					LET B = 21      ; Desplazamiento en WorldMap
					LET U = 18
					LET A = 2 CALL 24835      ; Selecciona Banco Zona B
				ELSE
					AT 0 15 PRINT "Zona A"
					LET B = 0      ; Desplazamiento en WorldMap
					LET U = 21
					LET A = 1 CALL 24835      ; Selecciona Banco Zona A
				ENDIF	
			ENDIF
			
		; HECHO
			LET P = 255
	ENDIF

	 
EVENT MAINLOOP2

			AT 0 9 DISPLAY DOUBLEDIGITS N
			AT 0 0 DISPLAY DOUBLEDIGITS SCREEN

; TIMER
	ADD 1 TO J
	
; Corazón en Hud
	IF J 1
		INK 2
		AT 20 5
		MESSAGE 49
	ENDIF
	IF J > 25
		INK 2
		AT 20 5
		MESSAGE 50
		LET J 0
		ADD 1 TO T			; CUENTA UN SEGUNDO
	ENDIF
	
		; ciclo NOCHE Y DIA 
		; EN T 127 SE HACE DE NOCHE (CAMBIAR A BLOQUES DE NOCHE)
		; EN T 0   SE HACE DE DIA   (CAMBIAR A BLOQUES DE DIA)
		; 0 --- 64 --- 127 --- 191 		

	LET A = 0
	IF T 0
		AT 0 6 PRINT "                    "
		LET A = 20
		; Swap memory aqui
		LET T = 1
	ELSE
		IF T 64
			AT 0 6 PRINT "BRILLA LA NOCHE AZUL"
			LET A = 21
			; Swap memory aqui			
				LET OPT = A
					SILENCE	DELAY 2
					LET A = 5
					CALL 24835			; LOAD from BANK
					PLAYMUSIC 1	
			; Establece color bloque de agua
				INK 5
				PAPER 1
				LET A = 56	; bloque de agua
				LET B = 0	; BRILLO
				USER 18
				
				LET A = OPT
				REDRAW
			LET T = 65
		ELSE
			IF T 127
				AT 0 6 PRINT "                    "
				LET A = 22
				; Swap memory aqui
				LET T = 128
			ELSE
				IF T 191
					AT 0 6 PRINT "SOL RADIANTE Y CLARO"
					LET A = 23
					; Swap memory aqui
						LET OPT = A
							SILENCE	DELAY 2
							LET A = 4
							CALL 24835			; LOAD from BANK
							PLAYMUSIC 1	
					; Establece color bloque de agua
						INK 5
						PAPER 1
						LET A = 56	; bloque de agua
						LET B = 0	; BRILLO
						USER 18

						LET A = OPT
						REDRAW
											
					LET T = 192
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	
	IF A > 0
		ADD 1 TO T
		
		IF A > 23
			LET A 20
		ENDIF	
		AT A 0 PUTBLOCK 120					;LUNA 1
		AT A 1 PUTBLOCK 121					;LUNA 2
		
		ADD 1 TO A	
		IF A > 23
			LET A 20
		ENDIF
		AT A 0 PUTBLOCK 124				; LUNA 3
		AT A 1 PUTBLOCK 125				; LUNA 4
		
		ADD 1 TO A
		IF A > 23
			LET A 20
		ENDIF
		AT A 0 PUTBLOCK 122				; SOL 1
		AT A 1 PUTBLOCK 84				; SOL 2
		
		ADD 1 TO A
		IF A > 23
			LET A 20
		ENDIF
		AT A 0 PUTBLOCK 83				; SOL 3
		AT A 1 PUTBLOCK 104				; SOL 4		
	ENDIF

	 
EVENT INTROMENU
		
CLS		
BORDER 0
PAPER 0	
INK 7

; PRINTSPLASH INTRO
	LET A 1 CALL 24838

PLAYMUSIC 1

INK 2
;AT 4 25 MESSAGE 53 ;34
COLOUR 71 
;AT 21 0 DISPLAY TRIPLEDIGITS O

;Menu		
	LET CONTROL 99
	WHILE CONTROL 99	

		; TIMER
			ADD 1 TO K
			IF K 200
				ADD 1 TO J	
				LET K 0
			ENDIF
			
		; Corazón en Hud
			IF J 6
				INK 2
				AT 4 25
				MESSAGE 50		; corazon grande
			ENDIF
			IF J 14
				INK 2
				AT 4 25
				MESSAGE 49		; corazon pequeño
				LET J 1
			ENDIF
		
		IF KEY OPTION1
					LET CONTROL 0
		ENDIF
		IF KEY OPTION2
					LET CONTROL KEMPSTON
		ENDIF
		IF KEY OPTION3
					LET CONTROL SINCLAIR
		ENDIF							
		IF KEY OPTION4 				; redefine keys	
		WHILE KEY OPTION4 
		ENDWHILE

			INK 2 
			AT 14 12 
			MESSAGE 57
			BEEP 90		
					DEFINEKEY LEFT 
			AT 14 12       
			MESSAGE 58
			BEEP 82
				DEFINEKEY RIGHT		
			AT 14 12 
			MESSAGE 59 
			BEEP 74   
					DEFINEKEY UP 		
			AT 14 12  
			MESSAGE 60
			BEEP 66  
					DEFINEKEY DOWN     
			AT 14 12     
			MESSAGE 61
			BEEP 58
					DEFINEKEY FIRE1
			AT 14 12    
			MESSAGE 62
			BEEP 50
				DEFINEKEY FIRE2
			AT 14 12
			MESSAGE 63
			BEEP 40
			DEFINEKEY FIRE2
			AT 14 12
			PRINT "            "
		ENDIF
	ENDWHILE
	
; Para musica de menu
	;STOPMUSIC

; Borra pantalla
	CLS
	 
EVENT GAMEINIT

LET LIVES 100		; salud

;LET A = 0
;LET B = 0
;LET C = 0
;LET D = 0			; retardo salto
;E
;F
LET G = 0			; bloquea recolectar objetos 0-14
;H					; Objeto Mision
LET I = 0			; Iman
LET J = 0			; Latido corazon
LET K = 6			; La cogo para jump..el valor 6 es por llevar la tibia de salida
;L					; motor Isoba
LET M = 255			; Coordenadas X PLAYER (para Columna del MAGNETO)
;N
LET O = 0			; porcentaje de mision realizada

IF P <> 255
	LET P = 0			; PANELES 0 = on, 254 = off, (Stages = 1) en MLOOP1 Y STARTSCREEN
ENDIF

LET Q = 12			; PRIMER OBJETO
LET R = 13			; SEGUNDO OBJETO
LET S = 1			; VELOCIDAD, 1=CAMINA, 2=CORRE
LET T = 0			; TIEMPO DEL MUNDO (segundos)
;U					; MASK TEST
LET V = 1			; PESO
;W					; coordenada Y del PLAYER
;X
;Y
;Z					; profundida de MASK

; PRINT PANEL SCREEN 
	LET A 2 CALL 24838
	
; Establece color bloque de agua
	INK 5
	PAPER 1
	LET A = 56	; bloque de agua
	LET B = 0	; BRILLO
	USER 18

; Establece color bloque de background
	INK 7
	PAPER 0
	LET A = 0	; bloque base background
	LET B = 1	; BRILLO
	USER 18

; Inicia efemerides
	LET OPT = 1	; MODO SETUP
	USER 17		; CALL EVENTNEWHIGHSCORE

; Limpia Efemerides
	LET OPT = 3
	USER 17
	
; Genera Efemerides
	; Coloca Misiones (clave Objeto 40)
		RESTORE
		REPEAT 4
			READ B
			; SELECT SCNO A Y SAVE OBJ 40 EN efemeride A
				LET A = B
				USER 27			; SET INDEX = SCREEN B
				LET A = 40
				USER 25			; WRITE MISION
		ENDREPEAT
	
	; Coloca una pieza de reloj y una botella por cada eleccion al azar y una pieza de reloj mas
		RESTORE
		GETRANDOM 12		; hay 19 posiciones y las escogemos en bloques contiguos de 7
		LET A = RND
		ADD 5 TO A			; REPETIREMOS DESDE 4+1 + RND PARA USAR LA SEGUNDA TABLA
		REPEAT A
			READ B
		ENDREPEAT
		; Guardamos localizaciones
				   LET A = B USER 27	; SET INDEX = SCREEN B
			LET A = 36 USER 25				; WRITE relojA	
			READ B LET A = B USER 27
			LET A = 42 USER 25				; WRITE Botella	
			READ B LET A = B USER 27
			LET A = 37 USER 25				; WRITE relojB		
			READ B LET A = B USER 27
			LET A = 42 USER 25				; WRITE Botella		
			READ B LET A = B USER 27
			LET A = 38 USER 25				; WRITE relojC		
			READ B LET A = B USER 27
			LET A = 42 USER 25				; WRITE Botella		
			READ B LET A = B USER 27
			LET A = 39 USER 25				; WRITE relojD		

	; Misiones Fijas
		DATA 	1 5 13 36
		
	; Localizaciones posibles
		DATA 	24 25 23 12 30
				50 21 11 47  8 	9
				46
				18  3  0 32 35	42 40

	; Mapa
	;			                      23*                              12* 13       
	;			     50*  49  48  44  22  21*                          10  11*        
	;			                  47* 20  19                       6   7   8*   9*    
	;			                  46* 18* 17  16  15  14   1   2   3*  4   5    0*    
	;			                  45  24* 25* 26  28  29  30* 31  32* 33  34   35*    
	;			                              27          43  42*     36  37   38    
	;			                                                      39  40*  41
	;
 
EVENT RESTARTSCREEN


;LET M 1
;LET T 0
;LET L SCREEN		
		;ADD 100 TO L
		;USER L
		;LET L SCREEN

;LET IMAGE U
;PLOT LIVES 170

;IF TYPE 0 
;LET IMAGE U
;ENDIF

;INK 7
;AT 0 8
;PRINT "rNUREMBERG 1944s"
;COLOUR 7

	SILENCE
	DELAY 2

; GAME WINDOW
	IF P = 255
		IF SCREEN > 38
			AT 0 15 PRINT "Zona C"
			LET B = 39      ; Desplazamiento en WorldMap
			LET U = 5
			LET A = 3 CALL 24835      ; Selecciona Banco Zona C
		ELSE
			IF SCREEN > 20
				AT 0 15 PRINT "Zona B"
				LET B = 21      ; Desplazamiento en WorldMap
				LET U = 18
				LET A = 2 CALL 24835      ; Selecciona Banco Zona B
			ELSE
				AT 0 15 PRINT "Zona A"
				LET B = 0      ; Desplazamiento en WorldMap
				LET U = 21
				LET A = 1 CALL 24835      ; Selecciona Banco Zona A
			ENDIF	
		ENDIF
		; SetDesplazamiento B de Zonas en MAP
			LET A = 34 CALL 24835		; comentar
	ENDIF

	SILENCE
			
; RESET GETOBJECT BLOQUEO
	LET G = 0			; RESET GETOBJECT

; MASK ON SIN OBJETOS
	USER 15
	;LET U = 1
	IF A = 0
		;LET U = 0
	ENDIF

; CHECK MASK ENEMY NUMBER
	LET A = 0
	USER 22				; GET Z_COUNTER		
	IF A > 4			; enemigos maximos 
		USER 16			; MASKOFF
		;LET U = 0
	ENDIF

; INSPECCION en efemerides
	; SETPTR captura punteros de DATA EFEMERIDES
		; Esta hecho en EVENTGAMEINIT

	; READ SETTINGA lee efemeride para esta screen
		LET A = SCREEN
		USER 27			; SET INDEX = SCREEN
		LET OPT = 2		; modo READ A
		USER 17			; CALL EFFEMERIDES en EVENTNEWHIGHSCORE
	
	AT 0 5 DISPLAY A
	
; CHEQUEA EXPLORACION
	IF A = 0		; vacio
		LET A = SCREEN
		USER 27			; SET INDEX = SCREEN
		LET A = 1
		USER 25			; coloca EXPLORADO
	ENDIF
 
EVENT FELLTOOFAR


 
EVENT KILLPLAYER

LOSTGAME

 
EVENT LOSTGAME

CLS

 
EVENT COMPLETEDGAME

; FADE
	USER 29
	 
EVENT NEWHIGHSCORE

; MARCADOR DE PROGRESO EFEMERIDES
; Entrada A (dato)
; Modo de trabajo OPT
;
	IF OPT = 0
		AT 0 0 PRINT "HIGHSCORE"
		WAITKEY
	ENDIF
	
; MODOS
	IF OPT = 1
		; SETUP
			USER 26		; GET POINTERS, CAPTURA DIRECCIONES DE PUNTERO Y DATA
			RESTORE	
		EXIT
	ENDIF

	IF OPT = 2
		; READ
			READ A
		EXIT
	ENDIF

	IF OPT = 3
		; CLEAR
			REPEAT 55
				LET A = 0
				USER 25
			ENDREPEAT
		EXIT
	ENDIF


; EFEMERIDES 64 bytes
	; 56 SCREENS
	DATA 	0	40	0	0	0	40	0	0 		; 0
			0	0	0	0	0	40	0	0		; 8
			0	0	0	0	0	0	0	0		; 16
			0	0	0	0	0	0	0	0		; 24
			  
 		 	0	0	0	0	40	0	0	0		; 32
			0	0	0	0	0	0	0	0		; 40
			0	0	0	0	0	0	0	0		; 48
			
	; +8 MISIONES
			;0 0 0 0 0 0 0 0		
			

 
EVENT COLLECTBLOCK

; Gestion de inventario
; Entrada: OBJ
; Modo de trabajo: A = 1 Recoge, A = 2 Muestra mochila
; Offset NOMBRES/MESSAGES = 0, EN QUÉ OBJETO empieza la lista
; Añade en este evneto la logica de objetos de tu juego

COLOUR 71

		AT 0 19 DISPLAY G
		
; GAME OBJECTS
	IF A <> 2
		IF OBJ > 22		; ultimo objeto intercambiable (mochila)
			LET A = 3
		ENDIF
	ENDIF

; MOCHILA	
	IF A = 1
		IF AIRBORNE = 0
			IF G = 0		; posicion inicial x del objeto
				USER 19
				;LET G = X		; get X from object pos
				LET G = A		; get X from object pos
				IF DIRECTION = RIGHT
					;ADD 16 TO G			; OBJETO A LA DERECHA
					; CORRECCION POR VELOCIDA EXTRA
					IF S = 2
						;SUBTRACT 2 FROM G
					ENDIF
				ELSE
					IF DIRECTION = LEFT
						;SUBTRACT 16 FROM G		; OBJETO A LA IZQUIERDA
						; CORRECCION POR VELOCIDA EXTRA
						IF S = 2
							;ADD 2 TO G
						ENDIF
					ENDIF
				ENDIF
				EXIT	
			ELSE			; recorriendo objeto
				IF X = G
					USER 19
					LET B = A		; reserva coordenanda X de objeto
					GET OBJ
					LET G = 0
				ELSE
					EXIT
				ENDIF
			ENDIF
		ELSE
			LET G = 255
			EXIT
		ENDIF
		
		; CHEQUEAR OBJETOS

			; RUTINA DE LA MOCHILA A+QR pasa a ser AQ+R
			; A objeto cogido
			; Q,R pareja ordenada de objetos
			; check ordenar lista: si hay un cuarto objeto coge, reordena OBJ+QR para OBJQ y suelta R

				BEEP 15
				
				; CHECK Desplazar y dejar objeto sobrante (4,D)
					LET A = R			; SOLTAMOS R
					LET R = Q			; Q PASA A SER EL SEGUNDO (R)
					LET Q = OBJ			; OBJ PASA A SER EL PRIMERO (Q)

					IF A <> 255
						PUT B Y A			; COLOCA EL OBJETO QUE SOBRA en X coord Obj
					ENDIF
		
		; muestra lo que tengo
			LET A = 2
	ENDIF

; PANEL OBJETOS
	IF A = 2					
		; I fill the panel with everything I got (Q,R)
			; TEST
				;AT 0 0 DISPLAY TRIPLEDIGITS Q
				;AT 1 0 DISPLAY TRIPLEDIGITS R

			; LIMPIEZA
				AT 20 14 PRINT "  "
				AT 21 14 PRINT "  "
				AT 22 14 PRINT "  "
				AT 23 14 PRINT "  "
				AT 20 17 PRINT "        "
				AT 21 17 PRINT "        " 
				AT 22 17 PRINT "        "
				AT 23 17 PRINT "        "

			; PRIMERO

				LET A = Q
				AT 160 112 USER 13			;PUT 112 160 Q
				MULTIPLY A BY 2
				AT 20 17 MESSAGE A
				ADD 1 TO A
				AT 21 17 MESSAGE A
				
				; Obtiene los atributos Peso(V) y Magnetismo(I)

					RESTORE
					LET A = Q
					ADD 1 TO A				; AÑADE OFFSET (+ 1, REPEAT no puede ser 0)
					REPEAT A
						READ I
						READ V
					ENDREPEAT
	
			; SEGUNDO
			
				LET A = R
				IF A <> 255
					AT 176 112 USER 13			;AT Y X PINTA OBJETO = PUT X Y OBJ = PUT 112 176 R
					MULTIPLY A BY 2
					AT 22 17 MESSAGE A
					ADD 1 TO A
					AT 23 17 MESSAGE A
					
					; Suma los atributos Peso(V) y Magnetismo(I)						
						RESTORE				
						LET A = R
						ADD 1 TO A				; AÑADE OFFSET (+ 1, REPEAT no puede ser 0)
						REPEAT A
							READ B
							READ C
						ENDREPEAT
							ADD B TO I
							ADD C TO V
				ENDIF
				
		; DETERMINA K=7+I*2
			;LET K = 6
			;LET A = I
			;MULTIPLY A BY 2
			;ADD A TO K
			
		; DETERMINA K=8-V
			LET K = 8
			SUBTRACT V FROM K			

		; Modifica por Droga del salto y velocidad
			IF GOT 2		; VERDE salto
				LET K = 8
			ENDIF
			IF GOT 4		; BLACA velocidad
				LET S = 2
			ELSE
				LET S = 1
			ENDIF
		
		; BARRAS
			; LIMPIAR BARRAS
				INK 1
				PAPER 0
				LET A 20
				REPEAT 4
					AT A 9 PRINT " "
					AT A 10 PRINT " "
					ADD 1 TO A
				ENDREPEAT
				
			; LLENADO BARRA I
				IF I > 0
					INK 5
					LET A = 23
					REPEAT I
						AT A 9 PRINT "t"
						SUBTRACT 1 FROM A
					ENDREPEAT
					;INK 7
				ENDIF
			
			; LLENADO BARRA V
				IF V > 0
					INK 2
					LET A = 23
					REPEAT V
						AT A 10 PRINT "t"
						SUBTRACT 1 FROM A
					ENDREPEAT
					;INK 7
				ENDIF				
	
		; TERMINADO
			LET A = 4
	ENDIF

; OBJETOS DEL JUEGO
	IF A = 3
		; RESTO DE LOGICA AQUI
		; ...
			; si cojo llave 28 29 30 y 27 pinta en el hub
				IF OBJ 27				;(magenta)
					GET OBJ
					COLOUR 67
					BEEP 30
					AT 21 26
					PRINT "no"			; pinta llave en hub
				ENDIF
				
				IF OBJ 28				; (amarilla)
					GET OBJ 
					COLOUR 70
					BEEP 30
					AT 22 26
					PRINT "jk"
				ENDIF
				
				IF OBJ 29				; (azul)
					GET OBJ
					COLOUR 69
					BEEP 30
					AT 20 26
					PRINT "pq"
				ENDIF
				
				IF OBJ 30				; (roja)
					GET OBJ
					COLOUR 66
					BEEP 30
					AT 23 26
					PRINT "lm"
				ENDIF
			
			; si colisiona con puerta 23 24 25 y 26
				GET 27
				GET 28
				GET 29
				GET 30
				IF OBJ 23
					IF GOT 27			; y si tengo llave
						GET OBJ			; coge la puerta
						BEEP 70
					ELSE				; pero si no tengo llave
						SPRITERIGHT		; retrocede
					ENDIF
				ENDIF
				IF OBJ 24
					IF GOT 28			; y si tengo llave
						GET OBJ			; coge la puerta
						BEEP 70
					ELSE				; pero si no tengo llave
						SPRITELEFT		; retrocede
					ENDIF
				ENDIF
				IF OBJ 25				
					IF GOT 29			; y si tengo llave
						GET OBJ			; coge la puerta
						BEEP 70
					ELSE				; pero si no tengo llave
						SPRITERIGHT		; retrocede
					ENDIF
				ENDIF		
				IF OBJ 26
					IF GOT 30
						GET OBJ
						BEEP 70
					ELSE 
						IF DIRECTION RIGHT
							SPRITELEFT
						ELSE
							IF DIRECTION LEFT
								SPRITERIGHT
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			
			; BOTELLAS	
				IF OBJ 41
					; EJEMPLO BOTELLA DE SALUD
					GET OBJ
					LET LIVES = 100
				ENDIF
				
			; NPCs aqui
				IF OBJ 40
					; MARCO DIALOGO
						IF U = 0
							LET U = 21			; MARCO en Zona A
						ENDIF
						LET C = U
						USER 11
					; POSICION X DE OBJETO AHORA EN C
						;USER 19
						;LET C = A
						;LET OPT = B
					GET OBJ		
					
					; CHEQUEA TRADUCTOR
						LET B = 0		; NO TENGO
						IF Q = 6
							LET B = 1		; TENGO
						ELSE
							IF R = 6
								LET B = 1		; TENGO
							ENDIF
						ENDIF
						
					; CHEQUEA PARA MOSTRAR OBJETO MISION EN LOCALIZACION
						IF SCREEN = 1	; LOCALIZACION BEBE
							LET H = 0		; OBTENGO INFO "JUGAR"
							IF GOT 7		; OSITO (A)
								IF B = 1		; traductor
									; HAZ INTERCAMBIO
										IF Q = 7
												LET Q = 18
												GET 18		; COLECCIONO Objeto B
										ELSE
											IF R = 7
												LET R = 18	; LAGRIMAS (B)
												GET 18		; COLECCIONO Objeto B
											ENDIF
										ENDIF
									; ACTUALIZA PANEL OBJETOS
									; CALL PANEL OBJETOS
										LET A = 2
										USER 12
									LET H = 255		; OBTENGO INFO "COMPLETADA"
								ENDIF
							ENDIF
						ELSE
							IF SCREEN = 5	; LOCALIZACION HERBERT					
								; TENGO LAGRIMAS
									IF GOT 18		; LAGRIMAS
										IF B = 1		; traductor
											; HAZ INTERCAMBIO
												IF Q = 18
													LET Q = 17
													GET 17			; COLECCIONO Objeto B
												ELSE
													IF R = 18
														LET R = 17		; LLAVE PEQUENA (B)
														GET 17			; COLECCIONO Objeto B
													ENDIF
												ENDIF
											; ACTUALIZA PANEL OBJETOS
											; CALL PANEL OBJETOS
												LET A = 2
												USER 12
										ENDIF
									ENDIF
									
								; TENGO SEMILLA
									IF GOT 21		; semilla
										IF B = 1		; traductor
											; HAZ INTERCAMBIO
												IF Q = 21
													LET Q = 16
													GET 16			; COLECCIONO Objeto B
												ELSE
													IF R = 21
														LET R = 16		; MONOCULO (B)
														GET 16			; COLECCIONO Objeto B
													ENDIF
												ENDIF
											; ACTUALIZA PANEL OBJETOS
											; CALL PANEL OBJETOS
												LET A = 2
												USER 12
										ENDIF
									ENDIF
						
								; CHEQUEA DOS OBJETOS
									LET H = 0
									IF GOT 18		; LAGRIMAS
										IF GOT 21   	; Y ADEMAS TENGO SEMILLA
											IF B = 1		; traductor
												LET H = 255		; OBTENGO INFO "COMPLETADA"
											ENDIF
										ELSE
											LET H = 0		; OBTENGO INFO "SEMBRAR"
										ENDIF
									ELSE
										IF GOT 21
											LET H = 1		; OBTENGO INFO "REGAR"
										ENDIF
									ENDIF									
							ELSE
								IF SCREEN = 37		; EN CUALQUIER LUGAR
									IF B = 1		; traductor
										LET H = 255		; OBTENGO INFO "MITO LAZARO"
										; ACTIVO MISION 36
											; SELECT SCNO 36 Y SAVE OBJ 40 EN EFEM 36
												LET A = 36
												USER 27			; SET INDEX = SCREEN
												LET A = 40
												USER 25			; coloca MISION ZOMBIE
									ENDIF
								ELSE
									IF SCREEN = 36		; SALA DEL MUERTO
										LET H = 0		; ninguna INFO
										IF GOT 4		; PERVITIN (A)
											IF B = 1		; traductor
												; HAZ INTERCAMBIO
													IF Q = 4
														LET Q = 19
														GET 19			; COLECCIONO Objeto B
													ELSE
														IF R = 4
															LET R = 19		; FASCO VACIO (B)
															GET 19			; COLECCIONO Objeto B
														ENDIF
													ENDIF
												; ACTUALIZA PANEL OBJETOS
												; CALL PANEL OBJETOS
													LET A = 2
													USER 12
												LET H = 255		; OBTENGO INFO "COMPLETADA"
												GET 32
												PUT 16 120 31
											ENDIF
										ENDIF											
									ENDIF
								ENDIF
							ENDIF
						ENDIF
						
					; TEXTOS
						IF H = 255
							; PERSISTE SUB-MISION COMPLETADA!
								LET A = SCREEN
								USER 27			; SET INDEX = SCREEN
								LET A = 255
