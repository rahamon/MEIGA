EVENT PLAYER

;
;
; SETTINGA = timer MOVIMIENTO
; SETTINGB = timer DESCANSAR
; IMAGE = acciones
; K = altura salto
; D = Bloqueo salto
; M = Coordenada X publica
; S = CORRER
;

BORDER 0	
	
; INK 2
; SPRITEINK 7
; LET U IMAGE

FALL

; CHEQUEA GOLPE
	IF SETTINGA = 255						; CONTINUA
	ELSE
		; ESPERAR
			IF SETTINGA > 225
				SUBTRACT 1 FROM SETTINGA
				ANIMATE SLOW
				EXIT
			ELSE
				IF SETTINGA < 8
					IF IMAGE = 2
						SUBTRACT 1 FROM SETTINGA
						EXIT
					ENDIF
				ENDIF
			ENDIF
	ENDIF

	; RECOGE OBJETOS RAMON
	; LLAMAR AQUI A COLECTEDBLOCKEVENT CON RUTINA DE USUARIO
	; CLAVE: USAR EVENTO COLLECTBLOCK PARA GESTION DE LOGICA DE OBJETOS
	
		DETECTOBJ
		IF OBJ <> 255
			LET A = 1
			USER 12			; CALL COLLECTBLOCK
		ELSE
			LET G = 0
		ENDIF
						
		INK 7
		;AT 0 8
		;DISPLAY F	;DOUBLEDIGITS
		;AT 0  13
		;DISPLAY T	;TRIPLEDIGITS
		;AT  0 22
		;DISPLAY SCREEN	;TRIPLEDIGITS
		;AT  21 5
		;PRINT "F "
		;DISPLAY F		;TRIPLEDIGITS
		;AT  22 15
		;PRINT "Z "
		;DISPLAY A

; TEST MASK
;		USER 14
;		AT 0 0 DISPLAY Z
;		AT 0 2 PRINT "PLAYER     "
;		IF N = 3 PRINT "       " ENDIF
;		IF N = 4 PRINT "DETRAS " ENDIF
;		IF N = 5 PRINT "DELANTE" ENDIF


LET A = 0		; AIRE/PIE EN

	IF COLLISION 3
		LET A = 1		; PIE EN CAJA
	ELSE
		IF AIRBORNE = 0
			LET A = 1	; PIE EN SUELO
		ENDIF
	ENDIF

; PARCHE PARA CAMBIAR DIRECCION EN EL AIRE
	LET A = 1

IF A = 1					; EN PIE
	IF IMAGE <> 4				; ERGUIDO IZQ variable de on/off agachado	
		IF IMAGE <> 5				; ERGUIDO DER variable de on/off agachado
			IF KEY LEFT				; ORDEN IZQ izquierda
				LET SETTINGB 0
				SUBTRACT 2 FROM X
				IF LADDERBELOW
					SPRITELEFT
					LET IMAGE = 2
					LET FRAME = 0
					LET DIRECTION = DOWN
				ENDIF
				ADD 2 TO X
				IF LADDERBELOW			; EN CUERDA
					IF IMAGE = 2			; TREPANDO
						IF CANGOLEFT
							IF KEY FIRE
								SPRITELEFT		; DEJAME SALIR
								JUMP 2			; SALTA DE LA CUERDA
								LET DIRECTION = LEFT
								LET IMAGE = 0							
							ENDIF
						ENDIF				
					ENDIF
				ELSE
					LET DIRECTION LEFT
					LET IMAGE = 0
					REPEAT S
						IF CANGOLEFT
							SPRITELEFT			; MUEVE
						ENDIF
					ENDREPEAT
							ANIMATE MEDIUM
				ENDIF
			ELSE
				IF KEY RIGHT				; derecha
					LET DIRECTION RIGHT	
					LET SETTINGB 0
					IF LADDERBELOW		; EN CUERDA
						IF CANGORIGHT
							
						ELSE
							LET IMAGE = 2
							LET FRAME = 0
						ENDIF
					ELSE
						LET IMAGE 1
						ANIMATE MEDIUM
					ENDIF
					REPEAT S
						IF CANGORIGHT
							SPRITERIGHT				; MUEVE
						ENDIF
					ENDREPEAT
				ELSE
					; REPOSO
						IF IMAGE = 2
							LET IMAGE = 1
						ELSE
							; Hack Ladder
								USER 20
						ENDIF
						LET DIRECTION = DOWN
						;LET SETTINGB 0			
				ENDIF
			ENDIF		
		ENDIF
	ENDIF
ENDIF

	; CHEQUEA LIMITE PLATAFORMA
		IF IMAGE 0
			SUBTRACT 10 FROM X
			IF CANGODOWN
				IF AIRBORNE = 0
					IF CANGOLEFT
						IF DIRECTION = DOWN
							SPRITELEFT
							;LET DIRECTION = LEFT
							ANIMATE MEDIUM
						ENDIF
					;ELSE					
					;	LET DIRECTION = RIGHT
					ENDIF
				ENDIF
			ENDIF
			ADD 10 TO X
		ELSE
			IF IMAGE 1
				ADD 10 TO X
				IF CANGODOWN
					IF AIRBORNE = 0
						IF CANGORIGHT
							IF DIRECTION = DOWN
								SPRITERIGHT
								;LET DIRECTION = RIGHT
								ANIMATE MEDIUM
							ENDIF
						;ELSE
						;	LET DIRECTION = LEFT
						ENDIF
					ENDIF		
				ENDIF		
				SUBTRACT 10 FROM X
			ENDIF
		ENDIF
			
	IF LADDERBELOW			; AGARRATE
		IF IMAGE < 2
			LET IMAGE 2
			IF DIRECTION <> DOWN
				LET FRAME 0
				LET DIRECTION = DOWN
			ENDIF
			IF JUMPSPEED <> 0
				STOPFALL
			ENDIF
		ENDIF
	ENDIF

IF AIRBORNE <> 0
	IF A = 0		; EN AIRE
		IF DIRECTION = LEFT
			IF CANGOLEFT
				SPRITELEFT			; MUEVE
			ELSE
				IF JUMPSPEED < 128		; BAJANDO
					LET DIRECTION = DOWN
					;SPRITEDOWN
				ENDIF
			ENDIF
		ELSE
			IF DIRECTION = RIGHT
				IF CANGORIGHT
					SPRITERIGHT				; MUEVE
				ELSE
					IF JUMPSPEED < 128		; BAJANDO
						LET DIRECTION = DOWN
						;SPRITEDOWN
					ENDIF
				ENDIF			
			ENDIF
		ENDIF
	ENDIF			
ENDIF
	
IF AIRBORNE 0
	IF JUMPSPEED 0						;saltar
