EVENT SPRITETYPE2

;		USER 14
;		AT Z 0 DISPLAY Z
;		AT Z 2 PRINT "RATILLA    "
;		IF N = 3 PRINT "       " ENDIF
;		IF N = 4 PRINT "DETRAS " ENDIF
;		IF N = 5 PRINT "DELANTE" ENDIF


; RATILLA

		
IF DIRECTION = LEFT				; ratilla
	LET IMAGE = 11
	LET FRAME = 0
    IF CANGOLEFT
        SPRITELEFT
		SUBTRACT 16 FROM X
		IF CANGODOWN
			LET DIRECTION = RIGHT
		ENDIF
		ADD 16 TO X
	ELSE
		LET DIRECTION = RIGHT
	ENDIF
ELSE
	LET IMAGE = 12
	LET FRAME = 0
	IF CANGORIGHT
		SPRITERIGHT
		ADD 16 TO X
		IF CANGODOWN
			LET DIRECTION = LEFT
		ENDIF
		SUBTRACT 16 FROM X
	ELSE
		LET DIRECTION = LEFT
	ENDIF
ENDIF

ANIMATE SLOW


IF COLLISION 0 				; RATA NO MATA A MILKO ENCIMA PIEDRA
	;IF SETTINGA = 255
