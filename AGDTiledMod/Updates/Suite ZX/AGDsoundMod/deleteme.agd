DEFINEMESSAGES

 
EVENT PLAYER

; TIMING
; SETTINGB (TIMER)
; 0 GOLPE	DYING	25 				VIVO			 250		255 DEMASIADO ALTO
; <-----------------><-------------------------------><--------->
; 0 				25 								 250
; <-----------------><-------------------------------><--------->
; ANIMATE (PLAYER)
; FAMES
; 0--------1--------2--------3
; M = ACTION CODES
; 0,1,2,3 DIRECTIONS (LRUD); 10 JUMP LEFT; 11 JUMP RIGHT; 8 STAY; 18 SALTO ARRIBA; 16 GOLPE
; 20,21,28	AGACHADO
;
; IMAGES: 012 LEGS, 34 HEAD, 5 LEGS JUMP, 6 LEGS STAY
; CHECK COLOR ATTR
	SPRITEINK 7	

; VSYNC
	IF Y < 62
		;USER 32
	ENDIF

; DECODE BIN MOTION DIRECTION:		DDMMMMMM
	LET M = DIRECTION
	MULTIPLY M BY 4
	DIVIDE M BY 4					; M DECODED
	DIVIDE DIRECTION BY 64			; DIRECTION DECODED

; INSTANCIA MI CASCO
	IF N = 1
		SUBTRACT 8 FROM Y
		SPAWN 4 3				; instancia CASCO conmigo
		ADD 8 TO Y
		LET N = 2
		LET SETTINGB = 250
	ENDIF

; CHECK GOLPE (ACCION EXCLUYENTE)
	IF SETTINGB <= 25
		IF SETTINGB = 25
			; START DYING ACTION
				SOUND 105
		ENDIF
		; DYING ACTION
			SUBTRACT 2 FROM SETTINGB	; ANIMATE, SUBTRACT 1 FROM SETTINGB
			;ANIMATE
			;LET M = 16
		IF SETTINGB <= 2
			; end of GOLPE
				LET SETTINGB = 250		; END-ACTION GOLPE ACTION
		ENDIF
	ENDIF

; CONTROL
	IF SETTINGB > 25				; si está ACCION INACTIVA
		IF AIRBORNE = 0				; y en el suelo

			IF KEY LEFT
				LET IMAGE = 0				; ACTION CONDICIONADA
				LET DIRECTION = LEFT		; CAMINO A IZQUIERDA
				ANIMATE
				LET M = 0
			ELSE
				IF KEY RIGHT
					LET IMAGE = 1			; ACTION CONDICIONADA
					LET DIRECTION = RIGHT	; CAMINO A DERECHA
					ANIMATE
					LET M = 1
				ELSE
					LET IMAGE = 2				; ACTION CONDICIONADA
					LET FRAME = 0
					IF DIRECTION = RIGHT
						LET FRAME = 1				; ACTION CONDICIONADA
					ENDIF
					LET M = 8					
				ENDIF
			ENDIF
			
			LET A = 0
			IF KEY DOWN
				LET IMAGE = 6				; ACTION CONDICIONADA
				LET FRAME = 0
				IF DIRECTION = RIGHT
					LET FRAME = 1				; ACTION CONDICIONADA
				ENDIF
				LET A = 20
			ENDIF
			IF KEY UP
				LET IMAGE = 5				; ACTION CONDICIONADA: SI NO HACE OTRA COSA
				IF M = 8
					LET IMAGE = 2
				ENDIF
				LET FRAME = 0
				IF DIRECTION = RIGHT
					LET FRAME = 1				; ACTION CONDICIONADA
				ENDIF
				JUMP 7						; SALTO
				LET A = 10
			ENDIF
			ADD A TO M
			
		ENDIF
	ENDIF


; TEST
	IF KEY FIRE1
		;LET N = 255
		;CLS
		;ENDGAME
		LET A = 2
		CALL 24835
		EXIT
	ENDIF

	IF KEY FIRE2
		LET N = 0
		CLS
		LET A = 5
		CALL 24835
		redraw
	ENDIF
	

; CHECK MOVIMIENTO HORIZONTAL
	IF M < 20
		IF M <> 8
			IF M <> 18			; NO ES SALTO VERTICAL (18) NI REPOSO (8) NI AGACHADO (20,21,28)
				IF DIRECTION = LEFT	
					IF X <= LEFTEDGE
						SCREENLEFT
						LET X = RIGHTEDGE
						; DECODE BIN MOTION DIRECTION:		DDMMMMMM
							MULTIPLY DIRECTION BY 64		; DIRECTION ENCODED
							ADD M TO DIRECTION				; M ENCODED
						EXIT
					ELSE
						IF CANGOLEFT
							SPRITELEFT
							;ANIMATE
						ENDIF
					ENDIF
				ELSE
					IF DIRECTION = RIGHT
						IF X >= RIGHTEDGE
							SCREENRIGHT
							LET X = LEFTEDGE
							; DECODE BIN MOTION DIRECTION:		DDMMMMMM
								MULTIPLY DIRECTION BY 64		; DIRECTION ENCODED
								ADD M TO DIRECTION				; M ENCODED
							EXIT
						ELSE
							IF CANGORIGHT
								SPRITERIGHT
								;ANIMATE
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF

; CHECK JUMP/FALL
	LET A = JUMPSPEED
	IF A < 128
		IF A >= 12
			LET SETTINGB = 255		; demasiado alto flag
		ENDIF
	ENDIF


; CHECK FLOOR	
	IF CANGODOWN
		IF M < 10
			LET M = 6					; FALLING
		ENDIF
	ELSE							; ESTOY EN EL SUELO
		IF SETTINGB = 255			; si VENGO desde DEMASIADA VELOCIDAD
			; GOLPAZO
				LET SETTINGB = 25		; GOLPE!
				LET IMAGE = 2			; ACTION*
				JUMP 2
				LET M = 16
			; LET JUMPSPEED = 0
			; RESET SALUD/opcion Disminuye salud
				LET H = 100
		ENDIF
	ENDIF

; FALL
	FALL
	
; PUBLICAME
	LET V = X
	LET W = Y

; TEST
	AT 0 10 DISPLAY DOUBLEDIGITS M

; DECODE BIN MOTION DIRECTION:		DDMMMMMM
	MULTIPLY DIRECTION BY 64		; DIRECTION ENCODED
	ADD M TO DIRECTION				; M ENCODED


	
 
