EVENT INITSPRITE

; INSTANCIA PLAYER
	IF TYPE = 0
		LET SETTINGA = 8
	ENDIF

	IF TYPE = 4
		LET SETTINGA = 9
	ENDIF 
EVENT MAINLOOP1

				; BARRA
					LET A = 23
					LET B = H
					DIVIDE B BY 20			; INVERSO LONGITUD
					ADD A TO B				; B = H + 5
					WHILE A <= B
						AT 21 A PUTBLOCK 10
						ADD 1 TO A
					ENDWHILE
					AT 21 A PUTBLOCK 0


 
EVENT MAINLOOP2

; MUEVEME

	LET TYPE = 255
	LET A = 8					; SPRITE A BUSCAR POR VALOR DE PARAMETRO
	LET OPT = 11					; TIPO DE PARAMETRO (11=SETTINGA)
	USER 0						; BUSCA POR ID=SETTINGA
	IF A <> 255		; ENCUENTRA ALGUIEN CON MIM MISMA SETTINGA
		OTHER				; ESTE ES TU PARIENTE!
			LET V = X
			LET W = Y
			; DECODE BIN MOTION DIRECTION:		DDMMMMMM
				LET C = DIRECTION
				MULTIPLY C BY 4
				DIVIDE C BY 4					; M DECODED IN C
				LET A = DIRECTION
				DIVIDE A BY 64					; DIRECTION DECODED IN D
				LET D = A
		ENDSPRITE
		LET TYPE = PLAYER
		LET A = 9
		LET OPT = 11
		USER 0
		OTHER
			AT 5 15 DISPLAY TRIPLEDIGITS RND
		; NUEVA POSICION
			LET X = V
			LET Y = W
			SUBTRACT 10 FROM Y
			
	ENDIF


; DIBUJAME
	IF C < 10						; PIE
		LET IMAGE = 3	
		IF D = RIGHT
			LET IMAGE = 4
		ENDIF
		IF C > 3					; FALLING OR STAY
			LET FRAME = 1
		ELSE
			ANIMATE
		ENDIF
	ELSE
		IF C < 20					; AIRE
			LET IMAGE = 3	
			IF D = RIGHT
				LET IMAGE = 4
			ENDIF
			LET FRAME = 1
		ELSE
			IF C < 30				; SUELO
				ADD 4 TO Y
				LET IMAGE = 3	
				IF D = RIGHT
					LET IMAGE = 4
				ENDIF
				LET FRAME = 0
			ELSE
			ENDIF
		ENDIF
	ENDIF

		ENDSPRITE
 
EVENT INTROMENU

	IF N = 255
		AT 10 10 PRINT "ZERO STAGE"
		WAITKEY
		LET N = 0
	ELSE
		AT 10 10 PRINT "STAGE ONE"
		WAITKEY
	ENDIF
	
	
	
 
	EVENT GAMEINIT

LET H = 100

LET RND = 1 USER 100
 
EVENT RESTARTSCREEN

CLS
USER 4			; LIMPIA EL BUFFER DE BLOQUES FRONT

LET T = 0		; TIMER
LET K = 25		; DANHO

LET N = 1		; NEW SCREEN, ENCODE CANDIDATO: XXXX XXXN
LET E = 0		; RESET ENTITIES COUNTER

;TEST
	LET P = 0
	
; BARRA DE VIDA
	LET A = 0
	LET B = H
	DIVIDE B BY 10
	WHILE A < B
		AT 19 A PUTBLOCK 13
		ADD 1 TO A
	ENDWHILE
	AT 19 A PUTBLOCK 0


 
