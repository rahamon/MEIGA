REM CABECERA
REM COMUN
5 MODE 0
10 MEMORY &1FFF

REM CUERPO
REM CUERPO + SCR
15 GOSUB 300
20 LOAD "!Intro.scr",&C000
30 LET p=&D7D1: GOSUB 200

REM CUERPO + ASM
50 LOAD "screens.bin",&2000
60 CALL &2000

REM CUERPO + GAME
90 LOAD "AGDgame.bin",&2000
100 CALL &2000

110 STOP

REM PIE
REM PIE + SCR
200 FOR i=p TO p+15: LET N=PEEK (i)
240 INK (i-p),N:NEXT i
250 RETURN

300 FOR i=0 TO 15
340 INK i,0:NEXT i
350 RETURN

REM LOADER = CABECERA + CUERPO + PIE
run
